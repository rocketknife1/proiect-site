            { "key": "note", "label": "Explicație", "type": "text" }
          ],
          "newItem": { "label": "", "value": "", "note": "" }
        },
        {
          "key": "steps",
          "label": "Pașii „Tu aduci ideea”",
          "type": "list",
          "itemTitle": "title",
          "fields": [
            { "key": "title", "label": "Pas", "type": "text", "required": true },
            { "key": "text", "label": "Explicație", "type": "text" }
          ],
          "newItem": { "title": "", "text": "" }
        }
      ]
    }
  ]
