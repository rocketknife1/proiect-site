            { "key": "subtitle", "label": "Text mic dedesubt", "type": "text" },
            { "key": "href", "label": "Link (tel:07… pentru telefon sau adresă web)", "type": "text", "required": true },
            { "key": "icon", "label": "Simbol", "type": "text" },
