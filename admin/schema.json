            { "key": "hero.lead", "label": "Textul de sub titlul mare", "type": "longtext" },
            { "key": "agenda.title", "label": "Agenda — titlu", "type": "text" },
            { "key": "agenda.intro", "label": "Agenda — text", "type": "longtext" },
            { "key": "places.title", "label": "Locuri — titlu", "type": "text" },
            { "key": "places.intro", "label": "Locuri — text", "type": "longtext" },
            { "key": "trips.title", "label": "Excursii — titlu", "type": "text" },
            { "key": "trips.intro", "label": "Excursii — text", "type": "longtext" },
            { "key": "listings.title", "label": "Anunțuri — titlu", "type": "text" },
            { "key": "listings.intro", "label": "Anunțuri — text", "type": "longtext" },
            { "key": "valley.title", "label": "„O vale, șase orașe” — titlu", "type": "text" },
            { "key": "utile.title", "label": "Utile — titlu", "type": "text" },
            { "key": "utile.intro", "label": "Utile — text", "type": "longtext" },
            { "key": "community.title", "label": "„Tu aduci ideea” — titlu", "type": "text" },
            { "key": "community.text", "label": "„Tu aduci ideea” — text", "type": "longtext" },
            { "key": "footer.tagline", "label": "Subsol — motto", "type": "text" },
            { "key": "footer.note", "label": "Subsol — notă", "type": "longtext" }
          ]
        },
        {
          "key": "utile",
