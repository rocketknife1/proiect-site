  "imageDir": "images",
  "files": [
    {
      "path": "content.json",
      "sections": [
        {
          "key": "items",
          "label": "Locuri, excursii, anunțuri și evenimente",
          "description": "Tot ce apare în agendă, la locuri, excursii și anunțuri.",
          "type": "list",
          "itemTitle": "title",
          "itemSubtitle": "kind",
          "fields": [
            { "key": "kind", "label": "Ce este", "type": "select", "required": true, "options": [
              { "value": "event", "label": "Eveniment (agenda)" },
              { "value": "place", "label": "Loc de văzut" },
              { "value": "trip", "label": "Excursie de o zi" },
              { "value": "listing", "label": "Anunț" }
            ] },
            { "key": "title", "label": "Titlu", "type": "text", "required": true },
            { "key": "id", "label": "Cod pentru link (fără spații, ex. parang)", "type": "slug", "from": "title", "required": true },
            { "key": "town", "label": "Oraș", "type": "select", "required": true, "allowCustom": true, "options": [
              { "value": "Petroșani" }, { "value": "Petrila" }, { "value": "Aninoasa" },
              { "value": "Vulcan" }, { "value": "Lupeni" }, { "value": "Uricani" }, { "value": "Hunedoara" }
            ] },
            { "key": "kicker", "label": "Etichetă scurtă deasupra titlului", "type": "text" },
            { "key": "text", "label": "Descriere", "type": "longtext", "required": true },
            { "key": "img", "label": "Poza principală", "type": "image" },
            { "key": "icon", "label": "Simbol afișat când nu e poză", "type": "text", "showIf": { "key": "img", "empty": true } },
            { "key": "gallery", "label": "Alte poze (în pagina de detalii)", "type": "imageList" },
            { "key": "tags", "label": "Etichete", "type": "stringList" },
            { "key": "price", "label": "Preț (ex. 200 € / lună)", "type": "text", "showIf": { "key": "kind", "equals": "listing" } },
            { "key": "date", "label": "Data", "type": "date", "showIf": { "key": "kind", "equals": "event" } },
            { "key": "time", "label": "Ora", "type": "time", "showIf": { "key": "kind", "equals": "event" } },
            { "key": "where", "label": "Locul exact", "type": "text", "showIf": { "key": "kind", "equals": "event" } },
            { "key": "example", "label": "E doar un exemplu (apare marcat „Exemplu”)", "type": "bool", "showIf": { "key": "kind", "equals": "event" } },
            { "key": "map", "label": "Ce se caută în Google Maps", "type": "text" }
          ],
          "newItem": { "kind": "place", "title": "", "id": "", "town": "Petroșani", "kicker": "", "text": "", "img": null, "tags": [] }
